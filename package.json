{
  "name": "election-forecast-playground",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "python3 -m http.server 3000 -d out",
    "lint": "eslint . --max-warnings=0",
