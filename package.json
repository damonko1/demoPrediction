    "test": "vitest run",
    "build:historical-data": "node scripts/build-historical-data.mjs",
    "build:house-map": "node scripts/build-house-district-map.mjs",
    "build:legislative-data": "node scripts/build-legislative-data.mjs",
    "validate:house-map": "node scripts/validate-house-district-map.mjs",
    "validate:state-map": "node scripts/validate-state-map.mjs",
    "validate:legislative-data": "node scripts/validate-legislative-data.mjs"
  },
  "dependencies": {
    "lucide-react": "1.22.0",
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.9",
    "shapefile": "^0.6.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
